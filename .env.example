SOFTWARE_AGENT_LLM_PROVIDER=offline
SOFTWARE_AGENT_ENABLE_ONLINE_LLM=false
SOFTWARE_AGENT_OPENAI_MODEL=gpt-5-mini
SOFTWARE_AGENT_DEEPSEEK_MODEL=deepseek-v4-flash
SOFTWARE_AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com
SOFTWARE_AGENT_LLM_TIMEOUT=20
SOFTWARE_AGENT_LLM_MAX_OUTPUT_TOKENS=800
SOFTWARE_AGENT_NATIVE_MAX_ROUNDS=3
SOFTWARE_AGENT_NATIVE_MAX_TOOL_CALLS=8
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Step 26 shared control plane. PostgreSQL is the deployment backend.
SOFTWARE_AGENT_DATABASE_URL=postgresql://software_agent:change-me@postgres:5432/software_agent
SOFTWARE_AGENT_DB_PASSWORD=change-me

# Authentication remains disabled for local backward compatibility.
SOFTWARE_AGENT_AUTH_ENABLED=false
SOFTWARE_AGENT_READER_API_KEY=
SOFTWARE_AGENT_OPERATOR_API_KEY=
SOFTWARE_AGENT_ADMIN_API_KEY=
SOFTWARE_AGENT_API_KEY_PEPPER=
SOFTWARE_AGENT_DB_POOL_ENABLED=true
SOFTWARE_AGENT_DB_POOL_MIN_SIZE=1
SOFTWARE_AGENT_DB_POOL_MAX_SIZE=10
SOFTWARE_AGENT_AUDIT_LOG_PATH=data/audit/events.jsonl
PROMETHEUS_MULTIPROC_DIR=
