[
  {
    "query": "查询 openssl 的软件版本",
    "expected_tool": "package_search",
    "expected_answer_contains": [
      "openssl",
      "3.0.8",
      "1213"
    ]
  },
  {
    "query": "openssl 依赖哪些组件",
    "expected_tool": "dependency_analysis",
    "expected_answer_contains": [
      "libssl.so",
      "libcrypto.so"
    ]
  },
  {
    "query": "比较 openssl 两个版本变化",
    "expected_tool": "version_compare",
    "expected_answer_contains": [
      "1.1",
      "3.0.8",
      "deprecated API"
    ]
  },
  {
    "query": "1213 版本有哪些网络工具",
    "expected_tool": "package_search",
    "expected_answer_contains": [
      "openssl",
      "ethtool"
    ]
  },
  {
    "query": "tcpdump 需要哪些依赖",
    "expected_tool": "dependency_analysis",
    "expected_answer_contains": [
      "libpcap.so"
    ]
  },
  {
    "query": "nginx 从 1.20 到 1.24 有什么变化",
    "expected_tool": "version_compare",
    "expected_answer_contains": [
      "HTTP performance",
      "openssl"
    ]
  },
  {
    "query": "libssl.so 属于哪个软件包",
    "expected_tool": "component_mapping",
    "expected_answer_contains": [
      "libssl.so",
      "openssl"
    ]
  },
  {
    "query": "which package owns libpcap.so",
    "expected_tool": "component_mapping",
    "expected_answer_contains": [
      "libpcap.so",
      "tcpdump"
    ]
  },
  {
    "query": "release note says what was added in 1214",
    "expected_tool": "rag_retrieval",
    "expected_answer_contains": [
      "Release 1214",
      "nginx",
      "tcpdump"
    ]
  },
  {
    "query": "software manual describes tcpdump as what",
    "expected_tool": "rag_retrieval",
    "expected_answer_contains": [
      "tcpdump",
      "packet capture"
    ]
  },
  {
    "query": "1214 release packages and their dependencies",
    "expected_tools": [
      "rag_retrieval",
      "package_search",
      "dependency_analysis",
      "dependency_analysis"
    ],
    "expected_answer_contains": [
      "Release 1214",
      "nginx",
      "tcpdump",
      "openssl",
      "libpcap.so"
    ]
  },
  {
    "query": "according to release note, what dependencies do tcpdump have in 1214",
    "expected_tools": [
      "rag_retrieval",
      "package_search",
      "dependency_analysis"
    ],
    "expected_answer_contains": [
      "Release 1214",
      "tcpdump",
      "libpcap.so"
    ]
  }
]
